# ===========================================================================
# usebens-motor-decisao - environment variables
# ===========================================================================
# Copy this file to `.env` and adjust the values.
# NEVER commit the real `.env` (already ignored in .gitignore).
#
# .NET reads these as configuration keys. The double underscore (__) maps to a
# nested section, so DATABASE__HOST binds to Database:Host, etc.

# --- Runtime -------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# --- Credential strategy --------------------------------------------------
# Same pattern as the other Usebens services (e.g. usebens-okr):
#   Production (EKS): keep USE_SECRETS_MANAGER=true. Credentials are read from
#     AWS Secrets Manager via IRSA (IAM Role for Service Account) using the AWS
#     SDK default credential chain.
#   Local development: set USE_SECRETS_MANAGER=false to use the DATABASE__* parts
#     below (no AWS access required).
USE_SECRETS_MANAGER=false

# AWS region and the RDS-format secret name (only used when USE_SECRETS_MANAGER=true).
AWS_DEFAULT_REGION=us-east-1
POSTGRES_SECRET_NAME=databases/postgres-motor-decisao
#
# The secret is a JSON document in the RDS format the other services use:
#   {
#     "host": "...", "port": 5432,
#     "username": "...", "password": "...",
#     "dbname": "painel_okr"
#   }
# (the resolver also accepts "login" for user and "database" for dbname).
# The schema is fixed to usebens_motor_decisao regardless of the secret.

# --- Database (local dev; used when USE_SECRETS_MANAGER=false) --------------
# The engine stores everything in the dedicated schema usebens_motor_decisao,
# inside the shared PostgreSQL database.

# Option A - full connection string (takes precedence when set):
# DATABASE__CONNECTIONSTRING=Host=localhost;Port=5432;Database=painel_okr;Username=postgres;Password=postgres

# Option B - discrete parts:
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=painel_okr
DATABASE__USER=postgres
DATABASE__PASSWORD=postgres

# --- Redis (cache dos fluxos publicados) -----------------------------------
# Desligado por padrão: sem isto, o motor usa cache em memória (in-memory), o
# que funciona para rodar sem Docker. Ligue para usar o Redis local do
# docker-compose.dev.yml (host localhost:6379, senha "motor").
#
# Se o Redis estiver habilitado mas indisponível, o app cai automaticamente
# para o cache em memória (não quebra a subida).
REDIS__ENABLED=false

# Opção A - string completa (tem precedência quando definida):
# REDIS__CONNECTIONSTRING=localhost:6379,password=motor,abortConnect=false

# Opção B - partes discretas (batem com o docker-compose.dev.yml):
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=motor
# Prefixo das chaves no Redis (namespacing quando o Redis é compartilhado):
# REDIS__KEYPREFIX=motor:published-flow:
