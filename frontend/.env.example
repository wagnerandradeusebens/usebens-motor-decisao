# Frontend environment (Vite reads VITE_*-prefixed vars).
# Copy to `.env` if you need to override defaults.

# Where the .NET backend is running (used by the dev-server proxy for /api).
VITE_API_TARGET=http://localhost:5080

# In production, point the client at the deployed API origin instead of the
# dev proxy. Leave unset locally to use the /api proxy.
# VITE_API_BASE=https://motor-decisao.usebens.com.br
